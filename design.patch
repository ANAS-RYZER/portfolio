+"use client"
+
+import { skills } from "@/lib/data"
+import { Marquee } from "./marquee"
+import { SectionLabel } from "./section-label"
+
+const groups = [
+  { title: "Frontend", items: skills.frontend },
+  { title: "Backend", items: skills.backend },
+  { title: "Databases", items: skills.databases },
+  { title: "DevOps & Cloud", items: skills.devops },
+]
+
+const rowA = [...skills.frontend, ...skills.backend].map((s) => s.name)
+const rowB = [...skills.databases, ...skills.devops, ...skills.tools].map((s) => s.name)
+
+function Pill({ label, filled }: { label: string; filled?: boolean }) {
+  return (
+    <span
+      className={`mx-2 inline-flex items-center rounded-full border px-6 py-3 font-display text-2xl font-bold tracking-tight md:mx-3 md:px-9 md:py-5 md:text-5xl ${
+        filled ? "border-lime bg-lime text-ink" : "border-line text-paper"
+      }`}
+    >
+      {label}
+    </span>
+  )
+}
+
+export function Stack() {
+  return (
+    <section id="stack" className="py-28 md:py-40">
+      <div className="mx-auto mb-16 max-w-[1400px] px-4 md:px-8">
+        <SectionLabel>Tech stack</SectionLabel>
+        <h2 className="font-display text-5xl font-extrabold leading-[0.9] tracking-tighter md:text-8xl">
+          Tools of the <span className="text-outline-lime">trade</span>
+        </h2>
+      </div>
+
+      <div className="flex flex-col gap-4 md:gap-6">
+        <Marquee baseVelocity={-2.5}>
+          {rowA.map((s, i) => (
+            <Pill key={s} label={s} filled={i % 4 === 0} />
+          ))}
+        </Marquee>
+        <Marquee baseVelocity={2.5}>
+          {rowB.map((s, i) => (
+            <Pill key={s} label={s} filled={i % 4 === 2} />
+          ))}
+        </Marquee>
+      </div>
+
+      <div className="mx-auto mt-20 grid max-w-[1400px] gap-px overflow-hidden rounded-3xl border border-line bg-line px-0 sm:grid-cols-2 lg:grid-cols-4 md:mx-8 mx-4">
+        {groups.map((g) => (
+          <div key={g.title} className="bg-ink p-6 md:p-8">
+            <h3 className="font-display text-xl font-bold">{g.title}</h3>
+            <ul className="mt-6 space-y-4">
+              {g.items.map((s) => (
+                <li key={s.name}>
+                  <div className="flex justify-between text-sm">
+                    <span>{s.name}</span>
+                    <span className="text-paper-dim">{s.level}%</span>
+                  </div>
+                  <div className="mt-2 h-px w-full bg-line">
+                    <div className="h-px bg-lime" style={{ width: `${s.level}%` }} />
+                  </div>
+                </li>
+              ))}
+            </ul>
+          </div>
+        ))}
+      </div>
+    </section>
+  )
+}
diff --git a/components/site/work.tsx b/components/site/work.tsx
new file mode 100644
index 0000000..a48574b
--- /dev/null
+++ b/components/site/work.tsx
@@ -0,0 +1,92 @@
+"use client"
+
+import { useRef } from "react"
+import Image from "next/image"
+import { motion, useScroll, useTransform } from "framer-motion"
+import { ArrowUpRight } from "lucide-react"
+import { projects } from "@/lib/data"
+import { SectionLabel } from "./section-label"
+
+type Project = (typeof projects)[number]
+
+function ProjectRow({ project, index }: { project: Project; index: number }) {
+  const ref = useRef<HTMLElement>(null)
+  const { scrollYProgress } = useScroll({ target: ref, offset: ["start end", "end start"] })
+  // Image drifts inside its frame (classic parallax window), title drifts the other way.
+  const imgY = useTransform(scrollYProgress, [0, 1], ["-12%", "12%"])
+  const titleY = useTransform(scrollYProgress, [0, 1], ["40%", "-40%"])
+  const flip = index % 2 === 1
+  const soon = "comingsoon" in project && project.comingsoon
+  const href = !soon && project.live ? project.live : undefined
+
+  return (
+    <article ref={ref} className="grid items-center gap-8 md:grid-cols-12 md:gap-10">
+      <a
+        href={href}
+        target={href ? "_blank" : undefined}
+        rel="noopener noreferrer"
+        className={`group relative block aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-ink-2 md:col-span-7 ${flip ? "md:order-2 md:col-start-6" : ""}`}
+      >
+        <motion.div style={{ y: imgY }} className="absolute -inset-y-[14%] inset-x-0">
+          <Image
+            src={project.image}
+            alt={project.name}
+            fill
+            sizes="(min-width: 768px) 58vw, 100vw"
+            className="object-cover transition-transform duration-700 group-hover:scale-105"
+          />
+        </motion.div>
+        <div className="absolute inset-0 bg-ink/10 transition-colors group-hover:bg-transparent" />
+        {href && (
+          <span className="absolute bottom-5 right-5 flex h-14 w-14 scale-75 items-center justify-center rounded-full bg-lime text-ink opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100">
+            <ArrowUpRight className="h-6 w-6" />
+          </span>
+        )}
+        {soon && (
+          <span className="absolute left-5 top-5 rounded-full bg-ink/80 px-3 py-1 text-xs uppercase tracking-widest text-lime backdrop-blur">
+            Coming soon
+          </span>
+        )}
+      </a>
+
+      <motion.div style={{ y: titleY }} className={`md:col-span-5 ${flip ? "md:order-1 md:col-start-1" : ""}`}>
+        <span className="font-display text-sm text-lime">{String(index + 1).padStart(2, "0")} / {project.category}</span>
+        <h3 className="mt-3 font-display text-3xl font-bold leading-tight tracking-tight md:text-5xl">{project.name}</h3>
+        <p className="mt-4 text-paper-dim leading-relaxed">{project.description}</p>
+        <ul className="mt-6 flex flex-wrap gap-2">
+          {project.technologies.slice(0, 5).map((t) => (
+            <li key={t} className="rounded-full border border-line px-3 py-1 text-xs text-paper-dim">
+              {t}
+            </li>
+          ))}
+        </ul>
+      </motion.div>
+    </article>
+  )
+}
+
+export function Work() {
+  return (
+    <section id="work" className="mx-auto max-w-[1400px] px-4 py-28 md:px-8 md:py-40">
+      <div className="mb-20 flex flex-col justify-between gap-6 md:mb-32 md:flex-row md:items-end">
+        <div>
+          <SectionLabel>Selected work</SectionLabel>
+          <h2 className="font-display text-5xl font-extrabold leading-[0.9] tracking-tighter md:text-8xl">
+            Things I&apos;ve
+            <br />
+            <span className="text-outline-lime">built</span>
+          </h2>
+        </div>
+        <p className="max-w-sm text-paper-dim">
+          From tokenized real-estate platforms to real-time collaboration tools — a few projects I&apos;m proud of.
+        </p>
+      </div>
+
+      <div className="flex flex-col gap-28 md:gap-44">
+        {projects.map((p, i) => (
+          <ProjectRow key={p.id} project={p} index={i} />
+        ))}
+      </div>
+    </section>
+  )
+}
