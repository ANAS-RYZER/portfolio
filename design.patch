-
-    const ctx = canvas.getContext("2d");
-    if (!ctx) return;
-
-    canvas.width = window.innerWidth;
-    canvas.height = window.innerHeight;
-
-    class Spark implements ISpark {
-      x: number;
-      y: number;
-      length: number;
-      alpha: number;
-
-      constructor(x: number, y: number) {
